# Build output.
/target/

# VDS S-3(9): the record is committed, not scratch. Only these two are ignored,
# because a governance record that is gitignored is not a record.
.vds/cache/
.vds/private/

# Never. A dependency wheel, a tarball or a binary blob in a governance
# repository is a supply-chain surface nobody reviewed.
*.whl
*.tar.gz
*.tgz

# Python bytecode from the retired v0 toolchain.
__pycache__/
*.pyc
