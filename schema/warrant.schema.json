{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Warrant",
  "type": "object",
  "required": [
    "appealable",
    "assent_source",
    "bench",
    "case_file_digest",
    "created_at",
    "directives",
    "evidence",
    "forbidden",
    "granted_by",
    "holding",
    "id",
    "issue",
    "project",
    "reserved",
    "runtime_summary",
    "stage",
    "status",
    "supersedes",
    "unlocks"
  ],
  "properties": {
    "acceptance_event": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/AcceptanceEvent"
        },
        {
          "type": "null"
        }
      ]
    },
    "appealable": {
      "type": "boolean"
    },
    "assent_source": {
      "$ref": "#/definitions/AssentSource"
    },
    "bench": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_file_digest": {
      "description": "The sha256 of the case file the grant was made on. Repeated verbatim from the convening record, so what was decided on is provable after the fact (VDS S-10(5)).",
      "type": "string"
    },
    "created_at": {
      "$ref": "#/definitions/Timestamp"
    },
    "directives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceEntry"
      }
    },
    "exceptions": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "granted_at": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "granted_by": {
      "$ref": "#/definitions/GrantedBy"
    },
    "grantor_citation": {
      "description": "The VJS order that granted it. Null only for W3, which is the Principal's and has an acceptance event instead.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "holding": {
      "type": "string"
    },
    "id": {
      "$ref": "#/definitions/WarrantId"
    },
    "issue": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "reserved": {
      "description": "Every reserved clause this warrant relies on. VDS S-9(10) requires a warrant relying on the informational-bare-elements interim to say so.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_summary": {
      "type": "string"
    },
    "source_opinion": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "$ref": "#/definitions/Stage"
    },
    "status": {
      "$ref": "#/definitions/WarrantStatus"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WarrantId"
      }
    },
    "surface": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Surface"
        },
        {
          "type": "null"
        }
      ]
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vote": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AcceptanceEvent": {
      "type": "object",
      "required": [
        "accepted_at",
        "accepted_by",
        "digest",
        "path",
        "surface_digest"
      ],
      "properties": {
        "accepted_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "accepted_by": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "surface_digest": {
          "description": "The digest of exactly what was accepted, so a later claim that a screen was accepted is checkable against the bytes (VDS S-6(7)).",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Accessibility": {
      "type": "object",
      "required": [
        "accessibleNameSource",
        "contrastFloors",
        "keyboard"
      ],
      "properties": {
        "accessibleNameSource": {
          "$ref": "#/definitions/NameSource"
        },
        "contrastFloors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContrastFloor"
          }
        },
        "keyboard": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyboardContract"
          }
        },
        "role": {
          "description": "ARIA role, or null where the component is a layout container with none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Amendment": {
      "type": "object",
      "required": [
        "at",
        "by",
        "contractVersion",
        "kind",
        "what"
      ],
      "properties": {
        "at": {
          "$ref": "#/definitions/Timestamp"
        },
        "by": {
          "type": "string"
        },
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "decisionLogId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/AmendmentKind"
        },
        "proofId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProofId"
            },
            {
              "type": "null"
            }
          ]
        },
        "warrantId": {
          "anyOf": [
            {
              "$ref": "#/definitions/WarrantId"
            },
            {
              "type": "null"
            }
          ]
        },
        "what": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AmendmentKind": {
      "type": "string",
      "enum": [
        "non_breaking",
        "breaking"
      ]
    },
    "AssentSource": {
      "type": "string",
      "enum": [
        "sovereign_assent",
        "standing_bounded_assent",
        "principal_acceptance"
      ]
    },
    "CodeCounterpart": {
      "type": "object",
      "required": [
        "exportName",
        "importPath",
        "sourceFile"
      ],
      "properties": {
        "exportName": {
          "type": "string"
        },
        "importPath": {
          "description": "The module specifier a screen imports from, as written in the import.",
          "type": "string"
        },
        "sourceFile": {
          "description": "Repository-relative path, no leading slash.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ComponentId": {
      "description": "A registered component, allocated as the highest on disk plus one (VDS S-4(4)).",
      "type": "string",
      "pattern": "^CMP-[0-9]{4}$"
    },
    "ContrastFloor": {
      "description": "A contrast floor: a REQUIREMENT, never a realisation (VDS S-2(6)).\n\n`boundary` and `against` name tokens or edges BY NAME. A literal value in either is a storing-form violation of VDS S-2(2), and `no_stored_values` looks for exactly that.",
      "type": "object",
      "required": [
        "against",
        "basis",
        "boundary",
        "minRatio"
      ],
      "properties": {
        "against": {
          "type": "string"
        },
        "basis": {
          "description": "Where the requirement comes from, e.g. \"WCAG 2.2 SC 1.4.11\".",
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "minRatio": {
          "type": "number",
          "format": "double"
        },
        "scope": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/FloorScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Demand": {
      "description": "How many routes consume this component. Measured, never estimated (VDS S-5(7)), which is why the command that measured it is part of the value.",
      "type": "object",
      "required": [
        "measuredAt",
        "measuredBy",
        "routes"
      ],
      "properties": {
        "measuredAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "measuredBy": {
          "description": "The exact command that produced the count.",
          "type": "string"
        },
        "routes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "description": "One proof a warrant rests on.\n\n`digest` is copied from the record on disk and never from a caller: a warrant that cites a digest the caller supplied proves the caller.",
      "type": "object",
      "required": [
        "digest",
        "kind",
        "proof_id",
        "status"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ProofKind"
        },
        "proof_id": {
          "$ref": "#/definitions/ProofId"
        },
        "status": {
          "$ref": "#/definitions/ProofStatus"
        }
      },
      "additionalProperties": false
    },
    "FigmaNode": {
      "type": "object",
      "required": [
        "capturedAt",
        "fileKey",
        "nodeId"
      ],
      "properties": {
        "capturedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "fileKey": {
          "type": "string"
        },
        "nodeId": {
          "description": "A Figma node id, which is `<digits>:<digits>` in a file URL and `<digits>-<digits>` in a deep link. Both spellings are accepted because both are what a designer actually copies.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FloorScope": {
      "description": "What kind of thing the boundary is.\n\nVDS S-9(5): where a lower floor is genuinely correct, the lawful move is to change the component's SCOPE and state the basis, not to loosen the ratio. A factual claim about scope is contestable by a reviewer; a quietly lowered floor is not. That is why this field exists at all.",
      "type": "string",
      "enum": [
        "control_boundary",
        "text",
        "graphical_object",
        "decoration"
      ]
    },
    "GrantedBy": {
      "type": "string",
      "enum": [
        "vjs_court",
        "principal"
      ]
    },
    "KeyboardContract": {
      "type": "object",
      "required": [
        "effect",
        "key"
      ],
      "properties": {
        "effect": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "NameSource": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "children",
            "aria_label",
            "aria_labelledby",
            "title",
            "alt",
            "none_decorative"
          ]
        },
        {
          "description": "The HTML `<label>` association: a `for`/`id` pair, or a control wrapped by its label element.\n\nAdded because the set without it could not describe a text input, which is the single most common named control there is. `aria_labelledby` is a DIFFERENT mechanism, not a spelling of this one: it points at arbitrary elements by id and overrides the label association, so recording one where the code does the other publishes a contract the code does not keep. Found by adopting VDS on `examples/storefront`, where the only honest value for TextField was absent from the enum.",
          "type": "string",
          "enum": [
            "label"
          ]
        }
      ]
    },
    "ProofId": {
      "description": "A captured proof result, stamped with the UTC second it was captured.",
      "type": "string",
      "pattern": "^PROOF-[0-9]{8}-[0-9]{6}$"
    },
    "ProofKind": {
      "description": "The closed registry at VDS S-7(5).",
      "oneOf": [
        {
          "description": "Every component referenced by any declared screen exists in the register.",
          "type": "string",
          "enum": [
            "register_completeness"
          ]
        },
        {
          "description": "The register agrees with the codebase and with Figma, both directions.",
          "type": "string",
          "enum": [
            "reconciliation"
          ]
        },
        {
          "description": "No screen uses an unregistered component. The anti-drift proof.",
          "type": "string",
          "enum": [
            "composition"
          ]
        },
        {
          "description": "Every registered component's boundaries clear their floors in every theme.",
          "type": "string",
          "enum": [
            "contrast"
          ]
        },
        {
          "description": "Every required state of every registered component is drawn.",
          "type": "string",
          "enum": [
            "states"
          ]
        },
        {
          "description": "Each registered component's code counterpart matches its contract.",
          "type": "string",
          "enum": [
            "parity"
          ]
        },
        {
          "description": "The two named records agree where the pin declares them aligned.",
          "type": "string",
          "enum": [
            "token_pin"
          ]
        },
        {
          "description": "A component proposed for retirement has zero remaining consumers.",
          "type": "string",
          "enum": [
            "retirement_drain"
          ]
        },
        {
          "description": "Each generated ledger is current with its source.",
          "type": "string",
          "enum": [
            "ledger_staleness"
          ]
        },
        {
          "description": "`.vds/**` holds no realisation.",
          "type": "string",
          "enum": [
            "no_stored_values"
          ]
        }
      ]
    },
    "ProofStatus": {
      "description": "The three outcomes a proof record may carry.\n\nThere is no \"skipped\" and no \"warning\". VDS S-7(2)(4) requires a pass over zero enforceable rows to be recorded as `vacuous` and never as `passed`, and the absence of a fourth variant is what makes that structural.",
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "vacuous"
      ]
    },
    "PropContract": {
      "type": "object",
      "required": [
        "name",
        "required",
        "type"
      ],
      "properties": {
        "figmaProperty": {
          "description": "The corresponding Figma variant property, or null where the prop has no visual counterpart.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "description": "The TypeScript type expression, or a closed union written `a|b|c`.\n\nSerialised as `type`, which is the field name the contract publishes and a reserved word in Rust. The rename keeps the published shape rather than letting an implementation-language constraint leak into the artefact.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Stage": {
      "type": "string",
      "enum": [
        "W1_REGISTER_COMPLETE",
        "W2_DESIGN_COMPLETE",
        "W3_PRINCIPAL_ACCEPTED",
        "W4_PARITY"
      ]
    },
    "State": {
      "description": "The nine states, fixed by VDS S-5(3). A record may require a subset. It may not invent a tenth, and here it cannot.",
      "type": "string",
      "enum": [
        "default",
        "hover",
        "focus",
        "active",
        "selected",
        "disabled",
        "loading",
        "error",
        "success"
      ]
    },
    "StateContract": {
      "description": "Which of the nine states are required, which are drawn, which are built.\n\nStored as sorted, deduplicated vectors rather than sets so the serialised form is stable: a record's bytes must not depend on hash iteration order, or the register digest moves without the register moving.",
      "type": "object",
      "required": [
        "built",
        "drawn",
        "required"
      ],
      "properties": {
        "built": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/State"
          }
        },
        "drawn": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/State"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/State"
          }
        }
      },
      "additionalProperties": false
    },
    "Status": {
      "description": "The lifecycle at VDS S-5(4). A directed path where skipping is forbidden.",
      "type": "string",
      "enum": [
        "proposed",
        "designed",
        "registered",
        "built",
        "verified",
        "deprecated",
        "retired"
      ]
    },
    "Surface": {
      "description": "The surface a warrant was granted over. VDS S-6(4): a change to either digest spends the warrant.\n\nBoth digests are computed from LIVE state, never read back from a generated artefact. A surface digest taken from a ledger would go stale exactly when a screen changed and the ledger was not regenerated, which is the one moment it has to be right.",
      "type": "object",
      "required": [
        "register_digest",
        "screens_digest"
      ],
      "properties": {
        "register_digest": {
          "type": "string"
        },
        "screens_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "UTC, second resolution, trailing Z. The one canonical form VDS writes.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "WarrantId": {
      "description": "A warrant record. The stage number is part of the identifier so the four series are independent.",
      "type": "string",
      "pattern": "^WARRANT-W[1-4]-[0-9]{3}$"
    },
    "WarrantStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "granted",
            "refused",
            "superseded",
            "revoked"
          ]
        },
        {
          "description": "The surface it was granted over changed (VDS S-6(4)). Recorded, never deleted.",
          "type": "string",
          "enum": [
            "spent"
          ]
        }
      ]
    }
  }
}
