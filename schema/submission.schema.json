{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vds.local/schema/submission.schema.json",
  "title": "VDS submission",
  "description": "A question referred to VJS and the order that answered it. Governed by VDS S-10. VDS decides nothing; every judgement call leaves by this record. A submission must show its citator check, because a referral that re-litigates settled law wastes a bench and is defective (VDS S-10(2)).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "question",
    "trigger",
    "why_first_impression",
    "citator_checked",
    "options",
    "evidence",
    "case_file_digest",
    "filed_to",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SUBMISSION-(VDS-[0-9]{3}|[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6})$",
      "description": "Either a specification-reserved id (SUBMISSION-VDS-001 .. 005, the matters at VDS S-13) or a dated id allocated from disk."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "filed", "answered", "withdrawn"],
      "description": "Directory placement follows status: draft/ then filed/ then docket/."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "The single question put. A submission asking two questions gets one answer to neither."
    },
    "trigger": {
      "type": "string",
      "enum": [
        "first_impression",
        "genuine_distinction",
        "proposal_to_overrule",
        "instruction_conflicts_with_designpack",
        "discovered_breach"
      ],
      "description": "The enumerated triggers of VDS S-10(3). Anything outside this list is a decision log, not a referral."
    },
    "why_first_impression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "description": "Why this is not disposed of by existing law. Must engage the citator entries below."
    },
    "citator_checked": {
      "type": "array",
      "minItems": 1,
      "description": "Every near authority considered, and why each is not on all fours. At least one entry is required; a submission that names none has not checked (VDS S-10(2)).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation", "why_not_on_all_fours"],
        "properties": {
          "citation": {
            "type": "string",
            "pattern": "^\\[[0-9]{4}\\] VJS-[A-Z]+(-[A-Z]+)? [0-9]+$"
          },
          "why_not_on_all_fours": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "disposition": {
            "type": "string",
            "enum": ["distinguished", "precondition_unmet", "reserved_by_that_order", "persuasive_only"]
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "description": "Symmetric options with the case for and against each. The bench decides on a file that does not disclose the filer's preference, so no option may be marked preferred.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "case_for", "case_against"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "case_for": {
            "type": "string",
            "minLength": 1
          },
          "case_against": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": ["string", "null"],
            "description": "What this option costs to build and to keep, stated in work rather than adjectives."
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Every file the bench is asked to rely on, digest-pinned. An assertion with no evidence entry is an opinion.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/].*$"
          },
          "digest": {
            "$ref": "#/$defs/sha256"
          },
          "measured_by": {
            "type": ["string", "null"],
            "description": "The command that produced any figure quoted from this file. An unmeasured number is an opinion."
          }
        }
      }
    },
    "case_file_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of the case file as filed. Repeated verbatim in the convening record and in the resulting warrant (VDS S-10(5))."
    },
    "reserved_clause": {
      "type": ["string", "null"],
      "pattern": "^(S-[0-9]+\\([0-9]+\\))?$",
      "description": "The VDS clause held RESERVED pending this answer, for example \"S-6(5)\". Null where the referral does not block a clause."
    },
    "fail_closed_interim": {
      "type": ["string", "null"],
      "maxLength": 600,
      "description": "What the reserved clause does until the answer arrives. Required when reserved_clause is set: a reserved clause with no interim behaviour is an undefined state, not a safe one."
    },
    "filed_to": {
      "type": "string",
      "const": "vjs",
      "description": "Fixed. VDS has one forum and no appellate function of its own (VDS S-10(6))."
    },
    "vjs_submission_id": {
      "type": ["string", "null"],
      "description": "The id the submission was given in the VJS record, once filed."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "filed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "answer": {
      "description": "The order that disposed of the referral. Required non-null once status is answered.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["citation", "order_id", "ratio", "received_at"],
          "properties": {
            "citation": {
              "type": "string",
              "pattern": "^\\[[0-9]{4}\\] VJS-[A-Z]+(-[A-Z]+)? [0-9]+$"
            },
            "order_id": {
              "type": "string",
              "minLength": 1
            },
            "ratio": {
              "type": "string",
              "minLength": 1,
              "description": "The binding part, recorded verbatim. Only the ratio binds; obiter is persuasive."
            },
            "option_adopted": {
              "type": ["string", "null"],
              "pattern": "^([A-Z]|none_of_the_above)?$"
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "directives_for_vds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "appealable": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "answered"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["answer", "vjs_submission_id", "filed_at"],
        "properties": {
          "answer": {
            "type": "object"
          },
          "vjs_submission_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["filed", "answered"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["filed_at"],
        "properties": {
          "filed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reserved_clause": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["reserved_clause"]
      },
      "then": {
        "required": ["fail_closed_interim"],
        "properties": {
          "fail_closed_interim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
