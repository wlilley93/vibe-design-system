{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Submission",
  "type": "object",
  "required": [
    "case_file_digest",
    "citator_checked",
    "created_at",
    "evidence",
    "filed_to",
    "id",
    "options",
    "question",
    "status",
    "trigger",
    "why_first_impression"
  ],
  "properties": {
    "answer": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/SubmissionAnswer"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_file_digest": {
      "type": "string"
    },
    "citator_checked": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CitatorEntry"
      }
    },
    "created_at": {
      "$ref": "#/definitions/Timestamp"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fail_closed_interim": {
      "description": "What VDS does until the question is answered. VDS S-15(3): a reserved clause fails closed in the meantime, and the fail-closed position is written down rather than left to whoever reads the clause next.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "filed_at": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "filed_to": {
      "$ref": "#/definitions/FiledTo"
    },
    "id": {
      "$ref": "#/definitions/SubmissionId"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SubmissionOption"
      }
    },
    "question": {
      "type": "string"
    },
    "reserved_clause": {
      "description": "The VDS clause that depends on this question, where one does.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/definitions/SubmissionStatus"
    },
    "trigger": {
      "$ref": "#/definitions/SubmissionTrigger"
    },
    "vjs_submission_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "why_first_impression": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CitatorEntry": {
      "description": "One near authority the drafter considered, and why it is not on all fours.",
      "type": "object",
      "required": [
        "citation",
        "why_not_on_all_fours"
      ],
      "properties": {
        "citation": {
          "type": "string"
        },
        "why_not_on_all_fours": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FiledTo": {
      "description": "Always `vjs`. VDS refers and never decides, so there is nowhere else to file.",
      "type": "string",
      "enum": [
        "vjs"
      ]
    },
    "SubmissionAnswer": {
      "type": "object",
      "required": [
        "answered_at",
        "citation",
        "ratio"
      ],
      "properties": {
        "answered_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "citation": {
          "description": "The VJS citation, e.g. `[2026] VJS-CC-VDS 1`.",
          "type": "string"
        },
        "ratio": {
          "description": "The ratio, which is the only part that binds. Obiter is persuasive.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SubmissionId": {
      "description": "A question referred to VJS. The VDS-nnn series is reserved for the matters at VDS S-13.",
      "type": "string",
      "pattern": "^SUBMISSION-(VDS-[0-9]{3}|[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6})$"
    },
    "SubmissionOption": {
      "description": "An option the bench may take, with its consequence stated by the drafter.\n\nA submission that offers one option has not asked a question, it has requested a rubber stamp, which is why the schema requires at least two.",
      "type": "object",
      "required": [
        "consequence",
        "option"
      ],
      "properties": {
        "consequence": {
          "type": "string"
        },
        "option": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SubmissionStatus": {
      "type": "string",
      "enum": [
        "draft",
        "filed",
        "answered",
        "withdrawn"
      ]
    },
    "SubmissionTrigger": {
      "description": "The enumerated triggers at VDS S-10(3). Everything else is a decision log under VDS S-12(2), which is what keeps referral cheap enough to actually use.",
      "type": "string",
      "enum": [
        "first_impression",
        "genuine_distinction",
        "proposal_to_overrule",
        "instruction_conflicts_with_designpack",
        "discovered_breach"
      ]
    },
    "Timestamp": {
      "description": "UTC, second resolution, trailing Z. The one canonical form VDS writes.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
